let str = prompt("Enter a String");
let result = str[0];

for(let i=1; i<str.length; i++){
    let found = false;
    for(let j=0; j<result.length; j++){
        if(str[i] == result[j]){
            found = true;
            break;
        }
    }
    if(found == false){
            result = result + str[i];
        }
}

console.log(`After Removing the repeating characters : ${result}`);
